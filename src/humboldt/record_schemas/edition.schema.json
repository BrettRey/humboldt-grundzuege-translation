{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:humboldt:edition.schema.json",
  "title": "edition.schema.json",
  "type": "object",
  "properties": {
    "format": {
      "const": "humboldt.edition"
    },
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "datasets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "reading_defaults": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "section": {"type": "string", "pattern": "^[0-9]{1,6}[a-z]?$"},
          "source_id": {"type": "string", "minLength": 1},
          "target_id": {"type": "string", "minLength": 1}
        },
        "required": ["section", "source_id"],
        "additionalProperties": false
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "required": {
            "const": false
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256",
          "required"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format",
    "schema_version",
    "id",
    "datasets"
  ],
  "additionalProperties": false
}
